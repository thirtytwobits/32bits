---
/**
 * HomeTile — one project's tile on the Home overview.
 *
 * Full-bleed (100vw) hero image at 80vh on desktop / 60vh on mobile.
 * The whole tile is a clickable region linking to the project page.
 * Title is overlaid bottom-left using mix-blend-mode: difference for
 * legibility regardless of the underlying image.
 *
 * The first tile on the page should pass loading="eager" so the
 * largest contentful paint (LCP) image is high-priority.
 */
import { type CollectionEntry } from 'astro:content';
import { url } from '@lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  loading?: 'lazy' | 'eager';
}

const { project, loading = 'lazy' } = Astro.props;
const { title, slug, hero, summary, order } = project.data;
const projectPath = `/projects/${slug ?? project.id}`;
const href = url(projectPath);
// `meta` shows the canonical project path (no base prefix) so it reads
// the same in staging and production.
const meta = `${projectPath} · ${String(order).padStart(2, '0')}`;
---

<a href={href} class="tile">
  <img
    src={url(hero.src)}
    alt={hero.alt ?? ''}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    decoding="async"
  />
  {
    /* Scrim — a bottom-up dark gradient. Sits between image and overlay
      and exists for one purpose: guaranteeing the overlay text remains
      legible regardless of what's in the image. The scrim is
      *theme-invariant* (same in light and dark mode) for the same
      reason the image is — neither changes when you flip themes. */
  }
  <div class="scrim" aria-hidden="true"></div>
  <div class="overlay">
    <p class="meta">{meta}</p>
    <h2>{title}</h2>
    {summary && <p class="summary">{summary}</p>}
  </div>
</a>

<style>
  .tile {
    position: relative;
    display: block;
    width: 100vw;
    height: 80vh;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
  @media (max-width: 720px) {
    .tile {
      height: 60vh;
    }
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 600ms cubic-bezier(0.2, 0, 0.1, 1);
  }
  .tile:hover img {
    transform: scale(1.015);
  }
  /* Scrim: ~bottom 60% of the tile gets a transparent → 70% black
     gradient. Covers the area where overlay text sits. Above the scrim
     the image is fully visible. Theme-invariant (image is too). */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.7) 100%);
    pointer-events: none;
  }
  .overlay {
    position: absolute;
    bottom: 4rem;
    left: 4rem;
    right: 4rem;
    z-index: 2;
    /* Theme-invariant: always the warm cream from the light palette,
       regardless of `data-theme`. Using a hard-coded value (not a
       CSS variable) is intentional — the scrim is also fixed-tone,
       so the text color must match. */
    color: #f5f0e8;
    pointer-events: none;
  }
  @media (max-width: 720px) {
    .overlay {
      bottom: 2rem;
      left: 1.5rem;
      right: 1.5rem;
    }
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 0 0.5rem;
    /* Slightly muted version of the same warm cream — feels like a
       caption, not a title. */
    color: rgba(245, 240, 232, 0.75);
  }
  .tile h2 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0;
  }
  .summary {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.3vw, 1.1875rem);
    line-height: 1.45;
    margin: 1rem 0 0;
    max-width: 50ch;
    /* Slightly less intense than the title so the title leads. */
    color: rgba(245, 240, 232, 0.9);
  }
  /* Reduced-motion: no scale on hover. */
  @media (prefers-reduced-motion: reduce) {
    .tile:hover img {
      transform: none;
    }
  }
</style>
