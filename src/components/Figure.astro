---
interface Props {
  src: string | { src: string };
  alt: string;
  caption?: string;
  credit?: string;
  width?: 'normal' | 'wide' | 'full';
  lightbox?: boolean;
  lightboxSrc?: string | { src: string };
  link?: string;
  linkTarget?: '_blank' | '_self';
}

const {
  src,
  alt,
  caption,
  credit,
  width = 'normal',
  lightbox = true,
  lightboxSrc,
  link,
  linkTarget,
} = Astro.props;
const imageSrc = typeof src === 'string' ? src : src.src;
const fullImageSrc =
  typeof lightboxSrc === 'string' ? lightboxSrc : lightboxSrc ? lightboxSrc.src : imageSrc;
const lightboxCaption = [caption, credit].filter(Boolean).join(' ');
---

<figure class:list={['media-figure', `media-figure--${width}`]}>
  {
    link ? (
      <a
        class="media-figure__link"
        href={link}
        target={linkTarget}
        rel={linkTarget === '_blank' ? 'noopener noreferrer' : undefined}
      >
        <img src={imageSrc} alt={alt} loading="lazy" decoding="async" />
      </a>
    ) : lightbox ? (
      <a
        class="media-figure__lightbox-link"
        href={fullImageSrc}
        data-lightbox="image"
        data-lightbox-alt={alt}
        data-lightbox-caption={lightboxCaption}
        aria-label={caption ? `Open image: ${caption}` : 'Open image'}
      >
        <img src={imageSrc} alt={alt} loading="lazy" decoding="async" />
      </a>
    ) : (
      <img src={imageSrc} alt={alt} loading="lazy" decoding="async" />
    )
  }
  {
    (caption || credit) && (
      <figcaption>
        {caption && <span>{caption}</span>}
        {credit && <cite>{credit}</cite>}
      </figcaption>
    )
  }
</figure>
