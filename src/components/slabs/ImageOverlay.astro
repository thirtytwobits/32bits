---
/**
 * ImageOverlay — Slabs primitive: a full-viewport image with text laid
 * directly on top via mix-blend-mode (the same readability trick
 * HomeTile uses).
 *
 * No slab panel between text and image — the text is on the image
 * itself. Used in alternating sequences: TextSlab (solid panel) →
 * ImageOverlay (image with text) → TextSlab → ImageOverlay …
 *
 * Slot content can use `.display`, `.body`, or any inline elements;
 * default styling assumes a single short display-size statement (h2
 * equivalent). Authors override via class= on the inner element.
 */
import { url } from '@lib/url';

interface Props {
  image: string;
  alt: string;
  /** Set to "eager" only for the very first image above the fold. */
  loading?: 'lazy' | 'eager';
  /**
   * Where to align the overlay text within the viewport.
   * 'center' (default) | 'top' | 'bottom' | 'lower-left'.
   */
  align?: 'center' | 'top' | 'bottom' | 'lower-left';
}

const { image, alt, loading = 'lazy', align = 'center' } = Astro.props;
const src = url(image);
---

<section class:list={['image-overlay', `align-${align}`]}>
  <img
    src={src}
    alt={alt}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    decoding="async"
  />
  <div class="overlay">
    <slot />
  </div>
</section>

<style>
  .image-overlay {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }
  .image-overlay img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: 4rem;
    /* mix-blend-mode + light foreground = legible over any image. */
    color: var(--bg);
    mix-blend-mode: difference;
  }
  @media (max-width: 720px) {
    .overlay {
      padding: 2rem 1.5rem;
    }
  }
  .align-center .overlay {
    justify-content: center;
  }
  .align-top .overlay {
    justify-content: flex-start;
    padding-top: 6rem; /* below the floating topbar */
  }
  .align-bottom .overlay {
    justify-content: flex-end;
  }
  .align-lower-left .overlay {
    justify-content: flex-end;
    align-items: flex-start;
  }

  /* Slot content is always rendered as display-size statements over
     the image. Children are plain markdown paragraphs. */
  .overlay :global(p) {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0;
    max-width: 22ch;
  }
  .overlay :global(p + p) {
    margin-top: 1rem;
  }
  .overlay :global(em) {
    font-style: normal;
    color: var(--accent);
  }
  /* Inline links — accent-colored with underline. */
  .overlay :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
</style>
