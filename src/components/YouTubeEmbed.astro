---
interface Props {
  id: string;
  title: string;
  caption?: string;
  transcript?: string;
}

const { id, title, caption, transcript } = Astro.props;
const src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}`;
---

<figure class="youtube-embed">
  <div class="youtube-embed__frame">
    <iframe
      src={src}
      title={title}
      loading="lazy"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
  {
    (caption || transcript) && (
      <figcaption>
        {caption && <span>{caption}</span>}
        {transcript && <a href={transcript}>Transcript</a>}
      </figcaption>
    )
  }
</figure>
