---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import 'katex/dist/katex.min.css';
import SiteHeader from '../components/SiteHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import '../styles/themes.css';
import '../styles/global.css';
import '../styles/prose.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  lang?: string;
}

const {
  title = '32bits.io',
  description = 'Writing and professional work by Scott Dixon.',
  canonical = Astro.url.pathname,
  ogType = 'website',
  lang = 'en',
} = Astro.props;

const siteTitle = title === '32bits.io' ? title : `${title} - 32bits.io`;
const canonicalUrl = new URL(canonical, Astro.site ?? Astro.url).toString();
const trademarkPreviewUrl = new URL('/icons/icon-512.png', Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('32bits-theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.dataset.theme = theme;
          }
        } catch {
          /* localStorage can be unavailable in private contexts. */
        }
      })();
    </script>
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="32bits.io writing" href="/rss.xml" />
    <meta name="application-name" content="32bits.io" />
    <meta name="theme-color" content="#f7f6f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171817" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="32bits.io" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={trademarkPreviewUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="32bits.io faceted rock mark" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer page-shell">
      <p>© {new Date().getFullYear()} Scott Dixon</p>
      <SocialLinks />
    </footer>
    <div class="image-lightbox" id="image-lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" tabindex="-1" hidden>
      <button class="image-lightbox__close" type="button" data-lightbox-close aria-label="Close image viewer">
        <span aria-hidden="true">×</span>
      </button>
      <button class="image-lightbox__step image-lightbox__step--prev" type="button" data-lightbox-step="-1" aria-label="Previous item" hidden>
        <span aria-hidden="true">‹</span>
      </button>
      <figure class="image-lightbox__figure">
        <img data-lightbox-image alt="" />
        <video data-lightbox-video controls playsinline hidden></video>
        <figcaption class="image-lightbox__meta">
          <span class="image-lightbox__caption" data-lightbox-caption hidden></span>
          <span class="image-lightbox__counter" data-lightbox-counter hidden></span>
        </figcaption>
      </figure>
      <button class="image-lightbox__step image-lightbox__step--next" type="button" data-lightbox-step="1" aria-label="Next item" hidden>
        <span aria-hidden="true">›</span>
      </button>
    </div>
    <script>
      (() => {
        const lightbox = document.getElementById('image-lightbox');

        if (!lightbox || lightbox.dataset.lightboxReady === 'true') {
          return;
        }

        const image = lightbox.querySelector<HTMLImageElement>('[data-lightbox-image]');
        const video = lightbox.querySelector<HTMLVideoElement>('[data-lightbox-video]');
        const caption = lightbox.querySelector<HTMLElement>('[data-lightbox-caption]');
        const counter = lightbox.querySelector<HTMLElement>('[data-lightbox-counter]');
        const closeButton = lightbox.querySelector<HTMLElement>('[data-lightbox-close]');
        const stepButtons = Array.from(
          lightbox.querySelectorAll<HTMLButtonElement>('[data-lightbox-step]')
        );
        let previousFocus: HTMLElement | null = null;
        let group: HTMLAnchorElement[] = [];
        let index = 0;

        if (!image || !video || !caption || !counter) {
          return;
        }

        const closeLightbox = () => {
          if (lightbox.hidden) {
            return;
          }

          lightbox.hidden = true;
          document.documentElement.classList.remove('has-lightbox');

          video.pause();
          video.removeAttribute('src');
          video.removeAttribute('poster');
          video.load();
          image.removeAttribute('src');
          group = [];

          if (previousFocus?.isConnected) {
            previousFocus.focus();
          }

          previousFocus = null;
        };

        const show = (next: number) => {
          if (group.length === 0) {
            return;
          }

          index = (next + group.length) % group.length;

          const trigger = group[index];

          if (!trigger) {
            return;
          }

          const isVideo = trigger.getAttribute('data-lightbox-type') === 'video';

          video.pause();

          if (isVideo) {
            image.hidden = true;
            image.removeAttribute('src');
            video.hidden = false;
            video.src = trigger.href;

            const poster = trigger.getAttribute('data-lightbox-poster');
            if (poster) {
              video.poster = poster;
            } else {
              video.removeAttribute('poster');
            }
          } else {
            video.hidden = true;
            video.removeAttribute('src');
            video.removeAttribute('poster');
            video.load();
            image.hidden = false;
            image.src = trigger.href;
            image.alt =
              trigger.getAttribute('data-lightbox-alt') ?? trigger.querySelector('img')?.alt ?? '';
          }

          // A grouped trigger's enclosing <figure> is the whole gallery, so its
          // figcaption describes the set rather than this item: use the attribute.
          const sourceCaption = trigger.hasAttribute('data-lightbox-group')
            ? null
            : trigger.closest('figure')?.querySelector('figcaption');
          const captionHtml =
            sourceCaption?.innerHTML ?? trigger.getAttribute('data-lightbox-caption') ?? '';
          caption.innerHTML = captionHtml;
          caption.hidden = caption.textContent?.trim().length === 0;

          const hasSiblings = group.length > 1;
          counter.textContent = hasSiblings ? `${index + 1} / ${group.length}` : '';
          counter.hidden = !hasSiblings;

          stepButtons.forEach((button) => {
            button.hidden = !hasSiblings;
          });
        };

        document.addEventListener('click', (event) => {
          const target = event.target;

          if (!target || !('closest' in target)) {
            return;
          }

          const targetElement = target as Element;
          const trigger = targetElement.closest('[data-lightbox="image"]') as HTMLAnchorElement | null;

          if (!trigger || trigger.tagName !== 'A') {
            return;
          }

          event.preventDefault();
          previousFocus =
            document.activeElement && 'focus' in document.activeElement
              ? (document.activeElement as HTMLElement)
              : null;

          const groupName = trigger.getAttribute('data-lightbox-group');
          group = groupName
            ? Array.from(
                document.querySelectorAll<HTMLAnchorElement>(
                  `[data-lightbox="image"][data-lightbox-group="${groupName}"]`
                )
              )
            : [trigger];

          show(Math.max(0, group.indexOf(trigger)));

          document.documentElement.classList.add('has-lightbox');
          lightbox.hidden = false;

          if (closeButton) {
            closeButton.focus();
          } else {
            lightbox.focus();
          }
        });

        stepButtons.forEach((button) => {
          button.addEventListener('click', () => {
            show(index + Number(button.dataset.lightboxStep));
          });
        });

        lightbox.addEventListener('click', (event) => {
          if (event.target === lightbox) {
            closeLightbox();
          }
        });

        closeButton?.addEventListener('click', closeLightbox);

        document.addEventListener('keydown', (event) => {
          if (lightbox.hidden) {
            return;
          }

          if (event.key === 'Escape') {
            closeLightbox();
            return;
          }

          if (group.length < 2) {
            return;
          }

          if (event.key === 'ArrowRight') {
            event.preventDefault();
            show(index + 1);
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            show(index - 1);
          }
        });

        // Swipe between items on touch devices.
        let touchStartX = 0;
        let touchStartY = 0;

        lightbox.addEventListener(
          'touchstart',
          (event) => {
            const touch = event.changedTouches[0];

            if (!touch) {
              return;
            }

            touchStartX = touch.clientX;
            touchStartY = touch.clientY;
          },
          { passive: true }
        );

        lightbox.addEventListener(
          'touchend',
          (event) => {
            const touch = event.changedTouches[0];

            if (!touch || group.length < 2) {
              return;
            }

            const deltaX = touch.clientX - touchStartX;
            const deltaY = touch.clientY - touchStartY;

            if (Math.abs(deltaX) > 48 && Math.abs(deltaX) > Math.abs(deltaY)) {
              show(index + (deltaX < 0 ? 1 : -1));
            }
          },
          { passive: true }
        );

        lightbox.dataset.lightboxReady = 'true';
      })();
    </script>
  </body>
</html>
