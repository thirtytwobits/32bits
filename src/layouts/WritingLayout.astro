---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const updated = entry.data.updated;
const dateFormatter = new Intl.DateTimeFormat(entry.data.lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={`/writing/${entry.id}/`}
  ogType="article"
  lang={entry.data.lang}
>
  <article class="article page-shell">
    <header class="article-header">
      <p class="eyebrow">{entry.data.kind}</p>
      <h1>{entry.data.title}</h1>
      <p class="dek">{entry.data.description}</p>
      <div class="article-meta" aria-label="Article metadata">
        <time datetime={entry.data.published.toISOString()}>
          {dateFormatter.format(entry.data.published)}
        </time>
        {
          updated && (
            <>
              <span aria-hidden="true">Updated</span>
              <time datetime={updated.toISOString()}>{dateFormatter.format(updated)}</time>
            </>
          )
        }
        <span>{entry.data.status}</span>
      </div>
      {
        entry.data.topics.length > 0 && (
          <ul class="topic-list" aria-label="Topics">
            {entry.data.topics.map((topic) => (
              <li>{topic}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
