---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  comparePublishedNewestFirst,
  entryDateLabel,
  isVisibleEntry,
} from '../lib/editorial-dates';

const writing = (await getCollection('writing')).filter(isVisibleEntry).sort(comparePublishedNewestFirst);
const making = (await getCollection('making')).filter(isVisibleEntry).sort(comparePublishedNewestFirst);
const featured = writing.slice(0, 3);
const featuredMaking = making.slice(0, 3);
---

<BaseLayout
  title="32bits.io"
  description="Writing and professional work by Scott Dixon, focused on embedded systems, robotics, aerospace, automotive software, and durable engineering practice."
>
  <section class="hero page-shell">
    <h1>Software</h1>
    <p>(that's still a thing, right?)</p>
  </section>

  <section class="section page-shell" aria-labelledby="latest-writing">
    <h2 id="latest-writing">Writing</h2>
    {
      featured.length > 0 ? (
        <ul class="writing-list">
          {featured.map((entry) => (
            <li>
              <a href={`/writing/${entry.id}/`}>
                <div class="metadata">
                  <span>{entry.data.kind}</span>
                  <span>{entryDateLabel(entry)}</span>
                </div>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-note">Writing will appear here as pieces are published.</p>
      )
    }
  </section>

  <section class="section page-shell" aria-labelledby="latest-making">
    <h2 id="latest-making">Making</h2>
    {
      featuredMaking.length > 0 ? (
        <ul class="writing-list">
          {featuredMaking.map((entry) => (
            <li>
              <a href={`/making/${entry.id}/`}>
                <div class="metadata">
                  <span>{entry.data.kind}</span>
                  <span>{entryDateLabel(entry)}</span>
                </div>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-note">
          Dispatches about making, tools, artifacts, and the maker community will appear here.
        </p>
      )
    }
  </section>
</BaseLayout>
