---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { isPublishedEntry } from '../../lib/editorial-dates';
import MakingLayout from '../../layouts/MakingLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('making')).filter(isPublishedEntry);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'making'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<MakingLayout entry={entry}>
  <Content />
</MakingLayout>
