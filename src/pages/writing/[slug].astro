---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { isVisibleEntry } from '../../lib/editorial-dates';
import WritingLayout from '../../layouts/WritingLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('writing')).filter(isVisibleEntry);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<WritingLayout entry={entry}>
  <Content />
</WritingLayout>
