---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<BaseLayout
  title="About"
  description="About Scott Dixon and the professional scope of 32bits.io."
>
  <article class="article page-shell">
    <header class="article-header">
      <p class="eyebrow">About</p>
      <h1>Scott Dixon</h1>
      <p class="dek">
        Software engineer with more than 25 years of experience across embedded,
        robotics, aerospace, automotive, and large-scale product systems.
      </p>
    </header>
    <div class="prose">
      <p>
        This site is being rebuilt as a place for serious work: essays, technical
        notes, talks, case studies, and longer arguments that may eventually
        contribute to a thesis-shaped body of research.
      </p>
      <p>
        The first version is intentionally spare. The archive will earn more
        structure as the writing accumulates.
      </p>
      <SocialLinks />
    </div>
  </article>
</BaseLayout>
